# ─── Required ────────────────────────────────────────────
# JWT secret for signing tokens (MUST be set, min 64 random chars)
JWT_SECRET=

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crb
DB_USER=postgres
DB_PASSWORD=

# Prisma — connection string (used by Prisma CLI for migrations)
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/crb

# ─── Optional ────────────────────────────────────────────
# Server port (default: 3002)
API_PORT=3002

# CORS allowed origins — comma-separated (default: http://localhost:3001,http://localhost:3000)
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Portal public URL — used as a clickable link in notification emails (defaults to first CORS_ORIGIN if not set)
# PORTAL_URL=https://conferencehub.example.com

# Node environment (development | production)
NODE_ENV=development

# JWT token expiry (default: 8h)
JWT_EXPIRES_IN=8h

# Bcrypt hashing rounds (default: 12)
BCRYPT_ROUNDS=12

# Database connection pool (optional)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# TLS certificate verification (default: true; set to false for self-signed certs in dev)
TLS_REJECT_UNAUTHORIZED=true

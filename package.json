{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "smartroom-booking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "tsx server/index.ts",
    "dev:frontend": "vite",
    "build": "vite build",
    "build:server": "npx tsc --project tsconfig.server.json",
    "start": "prisma generate && node dist-server/server/index.js",
    "preview": "vite preview",
    "migrate:deploy": "npx prisma migrate deploy",
    "seed": "tsx -e \"fetch('http://localhost:3002/api/seed',{method:'POST'}).then(r=>r.json()).then(console.log)\"",
    "zip": "powershell -ExecutionPolicy Bypass -File scripts/build-zip.ps1",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "service:install": "node scripts/install-service.cjs install",
    "service:uninstall": "node scripts/install-service.cjs uninstall",
    "service:status": "node scripts/install-service.cjs status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.10",
    "@types/pg": "^8.16.0",
    "@vitejs/plugin-react": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.42.2",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "ldapts": "^8.1.6",
    "lucide-react": "^0.562.0",
    "marked": "^18.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-windows": "^1.0.0-beta.8",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "prisma": "7.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "vite": "^6.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "html-to-docx": "^1.8.0",
    "postcss": "^8.5.10",
    "puppeteer": "^24.42.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
